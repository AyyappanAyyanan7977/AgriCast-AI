# Copy to .env and fill in your Supabase project's values. Never commit .env.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_SUPABASE_ANON_KEY

# Weather uses Open-Meteo (no API key required for eligible non-commercial use).
# Weather falls back to a clearly labelled demo estimate when the provider is unreachable.
